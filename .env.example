# Copy this file to .env and fill in real values.

# Required Telegram bot token.
BOT_TOKEN=

# Optional comma-separated Telegram user IDs with admin access.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Base data directory for catalog.json and the default SQLite database file.
YUQA_DATA_DIR=data/yuqa

# Optional explicit SQLAlchemy database URL.
# Leave blank to use SQLite at <YUQA_DATA_DIR>/yuqa.db.
# For the provided Docker image, use sqlite:////data/yuqa.db if overriding.
DATABASE_URL=

# PostgreSQL settings for docker/compose.yaml.
# These values are consumed by the production compose file.
POSTGRES_DB=yuqa
POSTGRES_USER=yuqa
POSTGRES_PASSWORD=

# Whether to apply Alembic migrations automatically on startup.
YUQA_AUTO_MIGRATE=true

# Runtime logging.
# Use json in containers so logs are easy to aggregate.
YUQA_LOG_LEVEL=INFO
YUQA_LOG_FORMAT=plain

# Prometheus metrics endpoint.
# The production compose file enables it internally for Prometheus.
YUQA_METRICS_ENABLED=false
YUQA_METRICS_HOST=127.0.0.1
YUQA_METRICS_PORT=9000

# Optional host ports for observability services in docker/compose.yaml.
PROMETHEUS_PORT=9090
KIBANA_PORT=5601

# Elasticsearch heap for the bundled single-node observability stack.
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
